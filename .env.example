# GLOBA server configuration — copy to `.env` (never commit the real file).
# Everything here is OPTIONAL: GLOBA runs without any of it in demonstration mode.
# Secrets live only on the server; the browser never sees them.

# ── Server ─────────────────────────────────────────────────────────────
API_PORT=8787                 # dev API port (vite proxies /api here). In production `npm start` serves the app on PORT or API_PORT.
# PORT=8787
# GLOBA_CONTACT=you@example.com   # sent in the User-Agent to free public APIs (Open-Meteo, Wikipedia, Overpass) — please set this

# ── AI model (interpretation, ranking explanations, assistant, itinerary drafts) ──
# Option A: Anthropic  (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5
# Option B: any OpenAI-compatible API (OpenAI, Azure OpenAI gateway, OpenRouter, a local server…)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_PROVIDER=anthropic         # or: openai   (auto-detected from whichever key is set)

# ── Images (optional upgrade; Wikipedia images/summaries work without a key) ──
# https://unsplash.com/developers  — respect their attribution guidelines (GLOBA shows credit links)
UNSPLASH_ACCESS_KEY=

# ── Map tiles (2D map) ───────────────────────────────────────────────────
# Default: OpenStreetMap standard tiles — fine for personal/light use only, see
# https://operations.osmfoundation.org/policies/tiles/ . For production use a provider with a key:
# MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png
# MAP_TILE_KEY=your-key            # appended as ?key=…
# MAP_TILE_ATTRIBUTION=© <a href="https://www.maptiler.com/copyright/">MapTiler</a> © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# ── Keyless public data providers (URLs overridable, e.g. to self-host) ──
# GEOCODE_URL=https://geocoding-api.open-meteo.com/v1/search
# WEATHER_URL=https://api.open-meteo.com/v1/forecast
# WIKI_URL=https://en.wikipedia.org
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# FX_URL=https://api.frankfurter.dev/v1/latest

# ── Not yet connected (extension points exist in server/providers/registry.ts) ──
# ACCOMMODATION_API_KEY=
# ROUTING_API_KEY=
